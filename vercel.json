{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pages/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/magazines",
      "destination": "/magazine",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/article",
      "permanent": true
    }
  ]
}
