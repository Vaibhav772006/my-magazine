{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/article/:slug",
      "destination": "/article-view.html?slug=:slug"
    },
    {
      "source": "/magazine/business-woman-2026/read",
      "destination": "/magazine-view.html?id=business-woman-2026"
    },
    {
      "source": "/magazine/ceo-of-the-year-2026/read",
      "destination": "/magazine-view.html?id=ceo-of-the-year-2026"
    },
    {
      "source": "/magazine/marketing-leaders-2026/read",
      "destination": "/magazine-view.html?id=marketing-leaders-2026"
    },
    {
      "source": "/magazine/tech-leaders-2026/read",
      "destination": "/magazine-view.html?id=tech-leaders-2026"
    },
    {
      "source": "/magazine/ceo-visionary-2026/read",
      "destination": "/magazine-view.html?id=ceo-visionary-2026"
    },
    {
      "source": "/magazine/:id/read",
      "destination": "/magazine-view.html?id=:id"
    },
    {
      "source": "/magazine/:id",
      "destination": "/magazine-view.html?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/article-view.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[^&]+)"
        }
      ],
      "destination": "/article/:slug",
      "permanent": true
    },
    {
      "source": "/pages/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/magazines",
      "destination": "/magazine",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/article",
      "permanent": true
    }
  ]
}
