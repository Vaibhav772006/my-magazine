{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/magazine/:id/read",
      "destination": "/magazine-view.html?id=:id"
    },
    {
      "source": "/magazine/:id",
      "destination": "/magazine-preview.html?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/pages/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/magazines",
      "destination": "/magazine",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/article",
      "permanent": true
    }
  ]
}
