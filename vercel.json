{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(css|js|images|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/article/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/magazine/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/articles/:slug",
      "destination": "/article/:slug",
      "permanent": true
    },
    {
      "source": "/article-view.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[^&]+)"
        }
      ],
      "destination": "/article/:slug",
      "permanent": true
    },
    {
      "source": "/magazines",
      "destination": "/magazine",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/article",
      "permanent": true
    },
    {
      "source": "/pages/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pdf-view",
      "destination": "/pdf-view.html"
    },
    {
      "source": "/pdf-view.html",
      "destination": "/pdf-view.html"
    },
    {
      "source": "/article/:slug",
      "destination": "/api/article?slug=:slug"
    },
    {
      "source": "/beyond-business",
      "destination": "/beyond-business.html"
    },
    {
      "source": "/magazine-view",
      "destination": "/magazine-view.html"
    },
    {
      "source": "/magazine/business-woman-2026/read",
      "destination": "/magazine-view?id=business-woman-2026"
    },
    {
      "source": "/magazine/ceo-of-the-year-2026/read",
      "destination": "/magazine-view?id=ceo-of-the-year-2026"
    },
    {
      "source": "/magazine/marketing-leaders-2026/read",
      "destination": "/magazine-view?id=marketing-leaders-2026"
    },
    {
      "source": "/magazine/tech-leaders-2026/read",
      "destination": "/magazine-view?id=tech-leaders-2026"
    },
    {
      "source": "/magazine/ceo-visionary-2026/read",
      "destination": "/magazine-view?id=ceo-visionary-2026"
    },
    {
      "source": "/magazine/:id/read",
      "destination": "/magazine-view?id=:id"
    },
    {
      "source": "/magazine/:id",
      "destination": "/magazine-view?id=:id"
    }
  ]
}
