# Apache configuration for clean routing & DirectoryIndex
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect legacy article URLs to their clean route when a slug is supplied.
  RewriteCond %{THE_REQUEST} \s/+article-view\.html(?:[?\s]) [NC]
  RewriteCond %{QUERY_STRING} (^|&)slug=([^&]+) [NC]
  RewriteRule ^article-view\.html$ /article/%2? [R=301,L,NE]

  # Article detail pages use the article's stable slug.
  # Article detail pages: clean route to master article-view template
  RewriteRule ^article/([^/]+)/?$ article-view.html?slug=$1 [L,QSA,NE]
  RewriteRule ^articles/([^/]+)/?$ article-view.html?slug=$1 [L,QSA,NE]

  # Serve index.html for root directory
  RewriteRule ^$ index.html [L]

  # Clean URLs rewrites
  RewriteRule ^magazine/([^/]+)/read/?$ magazine-view.html?id=$1 [L,QSA,NE]
  RewriteRule ^magazine/([^/]+)/?$ magazine-view.html?id=$1 [L,QSA,NE]
  RewriteRule ^magazine/?$ magazine.html [L,QSA]
  RewriteRule ^magazines/?$ magazine.html [L,QSA]
  RewriteRule ^article/?$ article.html [L,QSA]
  RewriteRule ^articles/?$ article.html [L,QSA]
  RewriteRule ^about/?$ about.html [L,QSA]
  RewriteRule ^contact/?$ contact.html [L,QSA]
  RewriteRule ^search/?$ search.html [L,QSA]
  RewriteRule ^magazine-view/?$ magazine-view.html [L,QSA]
  RewriteRule ^article-view/?$ article-view.html [L,QSA]
  RewriteRule ^blog/?$ blog.html [L,QSA]
  RewriteRule ^blog-view/?$ blog-view.html [L,QSA]
  RewriteRule ^splash/?$ splash.html [L,QSA]
  RewriteRule ^pdf-view/?$ pdf-view.html [L,QSA]
</IfModule>
